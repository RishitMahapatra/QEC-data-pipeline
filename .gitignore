.env
**/.DS_Store
**/__pycache__/
**/.pytest_cache/
**/.venv/
venv/
starter/lake/
starter/reports/
starter/.coverage
datasets/
# generated evidence under results/ stays out of git, except the committed
# Part I analysis SQL and the small results files whitelisted at the end
**/results/**
!**/results/**/
!starter/results/README.md
!starter/results/part1/analysis/*.sql
*.parquet
*.pyc
.ipynb_checkpoints/
starter/.Trash-0/
starter/01_discovery.ipynb
TASK_SPLIT.md


# small generated evidence the brief asks us to submit (after *.parquet so the
# data_issues exception wins); large outputs (predictions.parquet,
# source_trace.parquet) stay out and are regenerated by make run / make train
!starter/results/part1/*.json
!starter/results/part1/data_issues.parquet
!starter/results/part1/analysis/*_result.csv
!starter/results/part2/metrics.json
!starter/results/part2/run.json
!starter/results/part2/report.md
!starter/results/part2/models/*.pkl
